<?xml version="1.0" encoding="UTF-8"?>

<launch>
	<!-- at least this thing that i saw on the web starts with the principal axis on X  -->
	<!--x y z, z is up btw         qx qy qz qw -->
	<!--or x y z  and tait angles, but inverted order!!!! y p r  -->

	<!-- node pkg="tf" type="static_transform_publisher" name="camera_link_broadcaster" args="0 0 1 0 0 0 1 map usb_cam 100" / -->
	<!-- node pkg="tf" type="static_transform_publisher" name="camera_link_broadcaster" args="0 0 1 1.570796325 0  1.570796325 map usb_cam 100" / -->
	<!-- node pkg="tf" type="static_transform_publisher" name="camera_link_broadcaster" args="0 0 1 0 0 1.570796325 map usb_cam 100" / -->
	<!-- node pkg="tf" type="static_transform_publisher" name="camera_link_broadcaster" args="0 0 1 3.14159265 3.14159265 1.570796325 map usb_cam_acer 100" / -->
	<arg name="camera_name" default="radius" />
	<arg name="room_name" value="$(arg camera_name)_room" />
	<arg name="machine" default="" />
	<include file="$(find vio_launch)/launch/includes/machines.xml"/>
	<group ns="$(arg camera_name)">
		<!-- node pkg="tf" type="static_transform_publisher" name="camera_link_broadcaster" args="0 0 1 3.14159265 0 -1.570796325 map usb_cam_acer 100" / -->
		<!-- node pkg="tf" type="static_transform_publisher" name="tripod_link_broadcaster" args="1 0 0.9015 0 0 0 map room 100" / -->
		<!-- node pkg="tf" type="static_transform_publisher" name="camera_link_broadcaster" args="0 0 1 0 0 0 base_link camera_link 100" / -->
		<!-- node pkg="tf" type="static_transform_publisher" name="camera_link_broadcaster2" args="0 0 0 0 0 0 camera_link camera_bottom_screw_frame 100" / -->


		<arg name="max_new_marker_error" default="0.08" />
		<arg name="max_track_error" default="0.2" />
		<arg name="cam_image_topic" default="cam0/image_raw" />
		<arg name="cam_info_topic" default="cam0/camera_info" />
		<arg name="output_frame" default="$(arg camera_name)_infra1_optical_frame" />
		<!-- package:// and NOT $(find ...): $(find) is expanded here, on the
		     machine reading this file, so the resulting path is wrong the
		     moment machine= sends the node elsewhere. The node resolves
		     package:// itself, against whatever workspace that machine has. -->
		<arg name="bundle_files" default="package://ar_test/bundles/room.xml" />

		<arg name="marker_size" default="13.0" />
		<!-- WHERE THIS RUNS IS A BANDWIDTH DECISION, NOT A TASTE ONE.
		     Left on the main pc, alvar pulls a whole raw 640x480 stream off the
		     pi (307 kB/frame, 9.2 MB/s at 30 fps) to produce a 7-float pose.
		     Everything between a camera pi and the main pc is bridged over one
		     wifi hop, measured 2026-10-15 at 127 kB/s, so a single raw stream
		     is already ~70x over budget. Passing machine:= puts alvar next to
		     the camera and only ar_pose_marker crosses that hop.

		     WHAT HAS TO BE TRUE ON THAT PI: ar_track_alvar and ar_test are
		     both built in the workspace machines.xml names for it (pervio_ws),
		     not just in the docker workspace. The bundle path itself is no
		     longer a problem - see the package:// note on bundle_files. -->
		<param name="ar_track_alvar/marker_size" value="$(arg marker_size)"/>
		<param name="ar_track_alvar/max_new_marker_error" value="$(arg max_new_marker_error)"/>
		<param name="ar_track_alvar/max_track_error" value="$(arg max_track_error)"/>
		<param name="ar_track_alvar/max_frequency" value="8.0"/>
		<param name="ar_track_alvar/marker_resolution" value="5"/>
		<param name="ar_track_alvar/marker_margin" value="2"/>
		<param name="ar_track_alvar/bundle_files" value="$(arg bundle_files)"/>
		<param name="ar_track_alvar/output_frame" value="$(arg output_frame)"/>
		<rosparam param="ar_track_alvar/proper_names" subst_value="True" >[$(arg room_name),'hey']</rosparam>

		<node name="ar_track_alvar" pkg="ar_track_alvar" type="findMarkerBundlesNoKinect" respawn="false" output="log"
		      machine="$(arg machine)" if="$(eval arg('machine') != '')">
			<remap from="camera_image" to="$(arg cam_image_topic)"/>
			<remap from="camera_info" to="$(arg cam_info_topic)"/>
		</node>
		<node name="ar_track_alvar" pkg="ar_track_alvar" type="findMarkerBundlesNoKinect" respawn="false" output="screen"
		      if="$(eval arg('machine') == '')">
			<remap from="camera_image" to="$(arg cam_image_topic)"/>
			<remap from="camera_info" to="$(arg cam_info_topic)"/>
		</node>
		<!-- says out loud when this camera CANNOT be calibrated (marker clipped / alvar down / clock skew). shows under 'AR Markers' -->
		<node name="ar_visibility" pkg="diagnostics_schema" type="ar_visibility.py" respawn="true" output="log">
			<param name="camera" value="$(arg camera_name)"/>
		</node>
		<node name="calib_node" pkg="ar_test" type="calib_room.py" respawn="false" output="screen" if="false">
			<param name="camera" value="$(arg camera_name)"/>
		</node>

	</group>
</launch>

